# Keitaro: адрес трекера (без /admin_api) и API-ключ из Профиль → API ключи
KEITARO_URL=https://tracker.example.com
KEITARO_API_KEY=
KEITARO_TIMEZONE=Europe/Moscow

# Что подставлять в форму создаватора по умолчанию (по имени из Keitaro)
DEFAULT_DOMAIN=kylovoa.com
DEFAULT_GROUP=FORTESTS
DEFAULT_SOURCE=FORTESTS
GOOGLE_URL=https://google.com

# SQLite по умолчанию; для Postgres: postgresql+psycopg://user:pass@localhost:5432/keitaro_wrapper
DATABASE_URL=sqlite:///./keitaro_wrapper.db
